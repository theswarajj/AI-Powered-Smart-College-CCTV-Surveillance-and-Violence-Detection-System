# =====================================================================
# SentinelX AI - Environment Configuration Example
# =====================================================================

# Model Checkpoints
MODEL_PATH=./runs/exp1/best.pth
YOLO_MODEL=yolov8n.pt
TRACKER_CONFIG=bytetrack.yaml

# Video Input (0 for default webcam, or path to MP4, or RTSP camera stream URL)
VIDEO_SOURCE=input_fight.mp4

# Storage Directories
FACE_DB_DIR=./face_db
ALERT_DIR=./alerts

# Detection Thresholds
FIGHT_THRESH_ON=0.68
FIGHT_THRESH_OFF=0.53

# FastAPI Server Port
API_HOST=0.0.0.0
API_PORT=5000
