# Auto detect text files and perform LF normalization
* text=auto

# Python and script sources
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Web and documentation
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary media and weight assets
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pt binary
*.pth binary
*.pkl binary
*.whl binary
